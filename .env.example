# Server Port
PORT=3000

# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGHIjklMNO...)
BOT_TOKEN=

# Admin Telegram Chat ID or Channel ID for instant order notifications
# Tip: message @userinfobot on Telegram to get your numeric Chat ID
ADMIN_CHAT_ID=

# Public HTTPS URL of your Mini App (required by Telegram for WebApp buttons)
# Example with cloudflared/ngrok: https://your-tunnel.trycloudflare.com
WEBAPP_URL=

# Admin Dashboard PIN (default: 1234)
ADMIN_PIN=1234

# Secret used to sign admin session tokens (change in production!)
SESSION_SECRET=nexus-kh-change-this-secret-in-production

# Allow testing in a normal desktop browser without Telegram initData (set false in production)
ALLOW_DEV_MODE=true
